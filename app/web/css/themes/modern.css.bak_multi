@CHARSET "UTF-8";
/* ==========================================================================
   Availability Booking Calendar - Modern (customisable)
   Every colour, font, radius and shadow below comes from the --modern-* variables.
   The defaults are declared once on the container; the script prints the saved
   customization after this file, so a saved value always wins.
   "[calendarContainer]" is replaced with #abWrapper_<calendar id>.
   ========================================================================== */
[calendarContainer]{
	--modern-page:#edf4fa; --modern-card:#ffffff; --modern-soft:#d3e5f4; --modern-line:#e0ecf6; --modern-accent:#4f93c9;
	--modern-heading:#1b3550; --modern-body:#3f556c; --modern-muted:#5b6e81; --modern-link:#245f93;
	--modern-btn:#2a6fa8; --modern-btn-text:#ffffff; --modern-btn-hover:#1f5a8c; --modern-btn2:#ffffff; --modern-btn2-text:#245f93;
	--modern-free:#dcefe6; --modern-free-text:#256a50;
	--modern-booked:#f3cfc4; --modern-booked-text:#a53a22;
	--modern-pending:#fbe5b5; --modern-pending-text:#8a5a00;
	--modern-past:#f6f0ec; --modern-past-text:#b8a8a1;
	--modern-font-head:'Poppins',system-ui,sans-serif; --modern-font-body:'Poppins',system-ui,sans-serif; --modern-fs:14px;
	--modern-error:#be3d21; --modern-ok:#256a50;
	--modern-r:18px; --modern-rb:12px; --modern-ri:10px; --modern-cell:12px; --modern-rc:min(var(--modern-r), 22px);
	--modern-shadow:0 10px 30px color-mix(in srgb, var(--modern-heading) 10%, transparent);
	--modern-dock-shadow:0 -12px 24px -18px color-mix(in srgb, var(--modern-heading) 40%, transparent);

	container-type: inline-size;
	container-name: abmodern;
	box-sizing: border-box;
	height: auto;
	background: var(--modern-page);
	border-radius: var(--modern-r);
	padding: 12px;
	font-family: var(--modern-font-body);
	font-size: var(--modern-fs);
	line-height: 1.5;
	color: var(--modern-body);
}
[calendarContainer] *,
[calendarContainer] *:before,
[calendarContainer] *:after{
	box-sizing: border-box;
}
[calendarContainer] .abClear{ clear: both; }
[calendarContainer] a{ outline: none; }
[calendarContainer] a:focus-visible,
[calendarContainer] .abMenuLocale a:focus-visible{
	outline: 2px solid var(--modern-accent);
	outline-offset: 2px;
}

/* ---- toolbar (several-months views, language flags, back link) ---- */
[calendarContainer] .abMenu{
	height: auto;
	min-height: 0;
	overflow: visible;
	background: transparent;
	margin: 0 0 12px;
}
[calendarContainer] .abMenu:empty{ margin: 0; }
[calendarContainer] .abMenuNav{
	float: left;
	margin: 0;
	display: flex;
	gap: 8px;
}
[calendarContainer] .abMenuNav li{ float: none; padding: 0; }
[calendarContainer] .abMenuNav a,
[calendarContainer] .abMenuNav a:link,
[calendarContainer] .abMenuNav a:visited{
	display: inline-flex !important;
	align-items: center;
	justify-content: center;
	width: 38px !important;
	height: 38px !important;
	border-radius: 50%;
	border: 1px solid var(--modern-line);
	background: var(--modern-btn2);
	color: var(--modern-btn2-text);
	box-shadow: var(--modern-shadow);
	text-decoration: none;
}
[calendarContainer] .abMenuNav a:hover{
	border-color: var(--modern-accent);
	background: var(--modern-btn2);
}
[calendarContainer] .abMenuLocale{ float: right; }
[calendarContainer] .abMenuLocale li{ margin-left: 6px; }
[calendarContainer] .abMenuLocale a{
	border: 2px solid transparent;
	border-radius: var(--modern-ri);
	padding: 2px;
	background: var(--modern-card);
}
[calendarContainer] .abMenuLocale a.abLocaleFocus,
[calendarContainer] .abMenuLocale a:hover{
	border-color: var(--modern-accent);
}
[calendarContainer] .abMenu a.abReturnToAvailability:link,
[calendarContainer] .abMenu a.abReturnToAvailability:visited,
[calendarContainer] .abMenu a.abReturnToAvailability:active,
[calendarContainer] .abMenu a.abReturnToAvailability:hover,
[calendarContainer] .abMenu a.abReturnToAvailability:focus{
	display: inline-block;
	background: var(--modern-btn);
	color: var(--modern-btn-text);
	border-radius: 999px;
	padding: 6px 16px;
	font-weight: 600;
	text-decoration: none;
}
[calendarContainer] .abMenu a.abReturnToAvailability:hover{ background: var(--modern-btn-hover); }

/* ---- month card ---- */
[calendarContainer] table.abCalendarTable,
[calendarContainer] table.abCalendarTablePrice{
	background: var(--modern-card);
	border: 0;
	border-collapse: separate;
	border-spacing: 6px;
	table-layout: fixed;
	float: none;
	width: 100%;
	height: auto;
	margin: 0;
	padding: 12px;
	border-radius: var(--modern-r);
	box-shadow: var(--modern-shadow);
	font-family: var(--modern-font-body);
}
[calendarContainer] td.abCalendarMonth{
	background: transparent;
	border: 0;
	color: var(--modern-heading);
	font-family: var(--modern-font-head);
	font-size: calc(var(--modern-fs) * 1.3);
	font-weight: 600;
	text-align: center;
	vertical-align: middle;
	white-space: nowrap;
	padding: 0 0 8px;
}
[calendarContainer] td.abCalendarMonthPrev,
[calendarContainer] td.abCalendarMonthNext{
	width: auto;
	background: transparent;
}
[calendarContainer] .abCalendarMonthInner{
	overflow: visible;
	position: static;
	width: 100%;
	padding: 0;
	display: flex;
	align-items: center;
}
[calendarContainer] td.abCalendarMonthPrev .abCalendarMonthInner{ justify-content: flex-start; }
[calendarContainer] td.abCalendarMonthNext .abCalendarMonthInner{ justify-content: flex-end; }
[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:link,
[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:visited,
[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:active,
[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:hover,
[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:focus{
	display: inline-flex;
	align-items: center;
	justify-content: center;
	flex: none;
	width: 38px;
	height: 38px;
	border-radius: 50%;
	border: 1px solid var(--modern-line);
	background: var(--modern-btn2);
	color: var(--modern-btn2-text);
	font-size: 0;
	line-height: 0;
	text-decoration: none;
	box-shadow: var(--modern-shadow);
}
[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:hover{ border-color: var(--modern-accent); }
[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:before{
	content: "";
	width: 9px;
	height: 9px;
	border-left: 2.5px solid currentColor;
	border-bottom: 2.5px solid currentColor;
	display: block;
}
[calendarContainer] td.abCalendarMonthPrev a.abCalendarLinkMonth:before{
	transform: rotate(45deg);
	margin-left: 4px;
}
[calendarContainer] td.abCalendarMonthNext a.abCalendarLinkMonth:before{
	transform: rotate(-135deg);
	margin-right: 4px;
}

/* ---- week days, week numbers, days ---- */
[calendarContainer] td.abCalendarWeekDay,
[calendarContainer] td.abCalendarWeekNum{
	background: transparent;
	border: 0;
	color: var(--modern-muted);
	font-size: calc(var(--modern-fs) * 0.8);
	font-weight: 600;
	letter-spacing: .06em;
	text-transform: uppercase;
	text-align: center;
	vertical-align: middle;
}
[calendarContainer] td.abCalendarWeekDay span.abCalendarWeekDayInner{
	display: block;
	padding: 4px 0;
}
[calendarContainer] td.abCalendarWeekNum{ opacity: .7; }
[calendarContainer] td.abCalendarDate,
[calendarContainer] td.abCalendarToday,
[calendarContainer] td.abCalendarReserved,
[calendarContainer] td.abCalendarPending,
[calendarContainer] td.abCalendarPast,
[calendarContainer] td.abCalendarEmpty,
[calendarContainer] td.abCalendarPendingNightsStart,
[calendarContainer] td.abCalendarPendingNightsEnd,
[calendarContainer] td.abCalendarReservedNightsStart,
[calendarContainer] td.abCalendarReservedNightsEnd,
[calendarContainer] td.abCalendarNightsReservedReserved,
[calendarContainer] td.abCalendarNightsReservedPending,
[calendarContainer] td.abCalendarNightsPendingReserved,
[calendarContainer] td.abCalendarNightsPendingPending{
	border: 0;
	border-radius: var(--modern-cell);
	text-align: center;
	vertical-align: middle;
	font-size: var(--modern-fs);
	font-weight: 600;
	background-image: none;
	transition: filter .12s;
}
[calendarContainer] td.abCalendarEmpty{ background: transparent; }
[calendarContainer] .abCalendarCellInner{ height: 100%; position: relative; width: 100%; }
[calendarContainer] .abImageWrap{ display: none; }
[calendarContainer] .abCalendarLinkDate{
	width: 100%;
	padding: 14px 0;
	margin: 0;
	position: relative;
	line-height: 1.2;
}
[calendarContainer] .abCalendarLinkDateInner{ margin: auto; }
[calendarContainer] .abCalendarPriceStatic{ margin: 2px 0 0; font-size: .75em; font-weight: 500; }

/* availability statuses */
[calendarContainer] td.abCalendarDate,
[calendarContainer] td.abCalendarToday{
	background-color: var(--modern-free);
	color: var(--modern-free-text);
}
[calendarContainer] td.abCalendarReserved{
	background-color: var(--modern-booked);
	color: var(--modern-booked-text);
	background-image: repeating-linear-gradient(135deg, transparent 0 6px, color-mix(in srgb, var(--modern-card) 45%, transparent) 6px 8px);
}
[calendarContainer] td.abCalendarPending{
	background-color: var(--modern-pending);
	color: var(--modern-pending-text);
}
[calendarContainer] td.abCalendarPast{
	background-color: var(--modern-past);
	color: var(--modern-past-text);
	font-weight: 500;
}
/* change-over days (half available / half booked or pending) */
[calendarContainer] td.abCalendarReservedNightsStart{ background-color: var(--modern-booked); background-image: linear-gradient(135deg, var(--modern-free) 0 50%, transparent 50% 100%), repeating-linear-gradient(135deg, transparent 0 6px, color-mix(in srgb, var(--modern-card) 45%, transparent) 6px 8px); color: var(--modern-heading); }
[calendarContainer] td.abCalendarReservedNightsEnd{ background-color: var(--modern-booked); background-image: linear-gradient(135deg, transparent 0 50%, var(--modern-free) 50% 100%), repeating-linear-gradient(135deg, transparent 0 6px, color-mix(in srgb, var(--modern-card) 45%, transparent) 6px 8px); color: var(--modern-heading); }
[calendarContainer] td.abCalendarPendingNightsStart{ background-image: linear-gradient(135deg, var(--modern-free) 0 50%, var(--modern-pending) 50% 100%); color: var(--modern-heading); }
[calendarContainer] td.abCalendarPendingNightsEnd{ background-image: linear-gradient(135deg, var(--modern-pending) 0 50%, var(--modern-free) 50% 100%); color: var(--modern-heading); }
[calendarContainer] td.abCalendarNightsReservedPending{ background-color: var(--modern-booked); background-image: linear-gradient(135deg, transparent 0 50%, var(--modern-pending) 50% 100%), repeating-linear-gradient(135deg, transparent 0 6px, color-mix(in srgb, var(--modern-card) 45%, transparent) 6px 8px); color: var(--modern-heading); }
[calendarContainer] td.abCalendarNightsPendingReserved{ background-color: var(--modern-booked); background-image: linear-gradient(135deg, var(--modern-pending) 0 50%, transparent 50% 100%), repeating-linear-gradient(135deg, transparent 0 6px, color-mix(in srgb, var(--modern-card) 45%, transparent) 6px 8px); color: var(--modern-heading); }
[calendarContainer] td.abCalendarNightsReservedReserved{ background-color: var(--modern-booked); background-image: repeating-linear-gradient(135deg, transparent 0 6px, color-mix(in srgb, var(--modern-card) 45%, transparent) 6px 8px); color: var(--modern-booked-text); }
[calendarContainer] td.abCalendarNightsPendingPending{ background-color: var(--modern-pending); color: var(--modern-pending-text); }
[calendarContainer] td.abCalendarCell:hover{ filter: brightness(.96); }
[calendarContainer] td.abCalendarPast:hover,
[calendarContainer] td.abCalendarEmpty:hover{ filter: none; }

/* ---- legend ---- */
[calendarContainer] table.abCalendarLegend{
	clear: both;
	box-sizing: border-box;
	width: 100%;
	margin: 14px 0 0;
	padding: 10px 14px;
	background: var(--modern-card);
	border: 0;
	border-collapse: separate;
	border-spacing: 6px 0;
	border-radius: var(--modern-r);
	box-shadow: var(--modern-shadow);
	font-family: var(--modern-font-body);
	font-size: calc(var(--modern-fs) * 0.9);
	color: var(--modern-muted);
}
[calendarContainer] td.abCalendarColor{
	width: 16px;
	min-width: 16px;
	height: 1px; /* grows to the height of the label text beside it */
	padding: 0;
	font-size: 0;
	line-height: 0;
	border-radius: 5px;
}
[calendarContainer] td.abCalendarLabel{ padding: 0 12px 0 4px; line-height: 1.3; vertical-align: middle; }
[calendarContainer] td.abCalendarColorAvailable{ background: var(--modern-free); }
[calendarContainer] td.abCalendarColorReserved{
	background-color: var(--modern-booked);
	/* same diagonal stripes as the booked days in the calendar */
	background-image: repeating-linear-gradient(135deg, transparent 0 4px, color-mix(in srgb, var(--modern-card) 45%, transparent) 4px 6px);
}
[calendarContainer] td.abCalendarColorPending{ background: var(--modern-pending); }
[calendarContainer] td.abCalendarColorPast{ background: var(--modern-past); }

/* ---- several months per page ---- */
[calendarContainer].abWrapper13 table.abCalendarTable{ width: 100%; height: auto; margin: 0; }
[calendarContainer].abWrapper13 .abBox13{
	width: 33%;
	height: auto;
	float: left;
	margin: 0 0.5% 12px 0;
	padding: 0;
}
[calendarContainer].abWrapper13 .abBox13:nth-child(3n+3){ margin-right: 0 !important; }
/* equal-height month cards: each row of months is a flex row, the card look sits on the stretching box */
[calendarContainer].abWrapper13 .abRow{ display: flex; align-items: stretch; }
[calendarContainer].abWrapper13 .abBox13{
	display: flex;
	background: var(--modern-card);
	border-radius: var(--modern-r);
	box-shadow: var(--modern-shadow);
}
[calendarContainer].abWrapper13 .abBox13 table.abCalendarTable{
	align-self: flex-start;
	background: none;
	border-radius: 0;
	box-shadow: none;
}
[calendarContainer].abWrapper13 td.abCalendarMonth{ font-size: var(--modern-fs); }
[calendarContainer].abWrapper13 td.abCalendarDate,
[calendarContainer].abWrapper13 td.abCalendarReserved,
[calendarContainer].abWrapper13 td.abCalendarPending,
[calendarContainer].abWrapper13 td.abCalendarPast{ font-size: calc(var(--modern-fs) * 0.85); }

/* ---- messages ---- */
.abCalendarNote{ font-size: var(--modern-fs); margin-bottom: 12px; }
[calendarContainer] .abLoader .abLoaderMessage{ color: var(--modern-muted); }
/* ---- loader ---- */
[calendarContainer] .abLoader{
	min-height: 150px;
	padding: 28px 16px;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 14px;
	background: var(--modern-card);
	border-radius: var(--modern-r);
	box-shadow: var(--modern-shadow);
	overflow: hidden;
	text-align: center;
}
[calendarContainer] .abLoader .abLoaderInner{
	position: relative;
	width: 44px;
	height: 44px;
	margin: 0;
}
[calendarContainer] .abLoader .abLoaderInner .spinner-container{ display: none; }
[calendarContainer] .abLoader .abLoaderInner:before,
[calendarContainer] .abLoader .abLoaderInner:after{
	content: "";
	position: absolute;
	top: 0; right: 0; bottom: 0; left: 0;
	border-radius: 50%;
	border: 4px solid var(--modern-soft);
}
[calendarContainer] .abLoader .abLoaderInner:after{
	border-color: transparent;
	border-top-color: var(--modern-accent);
	border-right-color: var(--modern-accent);
	-webkit-animation: modernSpin .9s cubic-bezier(.5, .1, .5, .9) infinite;
	animation: modernSpin .9s cubic-bezier(.5, .1, .5, .9) infinite;
}
[calendarContainer] .abLoader .abLoaderMessage{
	font-family: var(--modern-font-body);
	font-size: calc(var(--modern-fs) * 0.9);
	line-height: 1.3;
	color: var(--modern-muted);
}
[calendarContainer] .abLoader .abLoaderMessage:empty{ display: none; }
@-webkit-keyframes modernSpin{ to{ -webkit-transform: rotate(360deg); } }
@keyframes modernSpin{ to{ transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce){
	[calendarContainer] .abLoader .abLoaderInner:after{ -webkit-animation-duration: 2.4s; animation-duration: 2.4s; }
}


@media screen and (max-width: 480px) {
	[calendarContainer]{ padding: 8px; }
	[calendarContainer] table.abCalendarTable,
	[calendarContainer] table.abCalendarTablePrice{ border-spacing: 4px; padding: 8px; }
	[calendarContainer] td.abCalendarMonth{ font-size: var(--modern-fs); }
	[calendarContainer] td.abCalendarDate,
	[calendarContainer] td.abCalendarReserved,
	[calendarContainer] td.abCalendarPending,
	[calendarContainer] td.abCalendarPast{ font-size: calc(var(--modern-fs) * 0.9); }
	[calendarContainer] table.abCalendarLegend td.abCalendarLabel{ padding-right: 6px; }
}
/* very small phones: let the legend bar fit the narrower card (no sideways scroll) */
@media screen and (max-width: 400px) {
	[calendarContainer] table.abCalendarLegend{ padding: 10px 6px; border-spacing: 2px 0; }
	[calendarContainer] table.abCalendarLegend td.abCalendarLabel{ padding-right: 2px; }
}
/* tablet / phone: keep the previous / next arrows in the flow, centred above the months (the base style
   positions them absolutely, which put them on top of the first month card) */
@media screen and (max-width: 768px) {
	[calendarContainer] .abMenuNav{
		position: static;
		top: auto;
		left: auto;
		transform: none;
		float: none;
		justify-content: center;
		width: max-content;
		margin: 0 auto;
	}
	[calendarContainer] .abMenu{ margin-bottom: 14px; }
	[calendarContainer] .abMenu:empty{ margin: 0; }
}
@media (max-width: 767px){
	[calendarContainer].abWrapper13 .abRow{ display: block; }
	[calendarContainer].abWrapper13 .abBox13{
		width: auto;
		float: none;
		margin: 0 0 14px;
	}
}

/* ==========================================================================
   Booking steps: booking form, summary, payment / confirmation
   (same markup as the Classic design; only restyled)
   ========================================================================== */
[calendarContainer] .abCalendarNote{ color: var(--modern-body); font-size: var(--modern-fs); margin: 0 0 12px; }
[calendarContainer] .abMenu{ display: flow-root; }
[calendarContainer] .abMenu .row{ display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0; }
[calendarContainer] .abMenu .row:before,
[calendarContainer] .abMenu .row:after{ display: none; }
[calendarContainer] .abMenu [class*="col-xs-"]{ float: none; width: auto; padding: 0; }
/* "Back to calendar(s)" links */
[calendarContainer] .abMenu a.abReturnToCalendar:link,
[calendarContainer] .abMenu a.abReturnToCalendar:visited,
[calendarContainer] .abMenu a.abReturnToCalendar:active,
[calendarContainer] .abMenu a.abReturnToCalendar:focus,
[calendarContainer] .abMenu a.abReturnToAvailability:link,
[calendarContainer] .abMenu a.abReturnToAvailability:visited,
[calendarContainer] .abMenu a.abReturnToAvailability:active,
[calendarContainer] .abMenu a.abReturnToAvailability:focus{
	display: inline-flex;
	align-items: center;
	float: none;
	background: var(--modern-btn2);
	color: var(--modern-btn2-text);
	border: 1px solid var(--modern-line);
	border-radius: 999px;
	padding: 6px 16px;
	line-height: 1.4;
	font-weight: 600;
	font-size: calc(var(--modern-fs) * .93);
	text-decoration: none;
	box-shadow: var(--modern-shadow);
}
[calendarContainer] .abMenu a.abReturnToCalendar:hover,
[calendarContainer] .abMenu a.abReturnToAvailability:hover{ border-color: var(--modern-accent); text-decoration: none; }
/* language dropdown */
[calendarContainer] .abMenu .pjRpbcLanguage .pjRpbcBtnNav{
	background: var(--modern-card);
	color: var(--modern-heading);
	border: 1px solid var(--modern-line);
	border-radius: var(--modern-ri);
	font-family: var(--modern-font-body);
	font-weight: 600;
	box-shadow: var(--modern-shadow);
}
[calendarContainer] .abMenu .pjRpbcLanguage .dropdown-menu{ border: 1px solid var(--modern-line); border-radius: var(--modern-ri); box-shadow: var(--modern-shadow); font-family: var(--modern-font-body); }
[calendarContainer] .abMenu .pjRpbcLanguage .dropdown-menu a{ color: var(--modern-body); }
[calendarContainer] .abMenu .pjRpbcLanguage .pjFdBtnActive{ background: var(--modern-soft); color: var(--modern-heading); }

/* ---- the form card ---- */
[calendarContainer] .abForm{
	margin: 0 0 12px;
	border: 0;
	border-radius: var(--modern-r);
	background: var(--modern-card);
	box-shadow: var(--modern-shadow);
	overflow: hidden;
	font-family: var(--modern-font-body);
	color: var(--modern-body);
}
[calendarContainer] .abForm a{ color: var(--modern-link); }
[calendarContainer] .abBox{ border: 0; overflow: visible; }
[calendarContainer] .abBox.abWhite,
[calendarContainer] .abBox.abGray{ background: transparent; }
[calendarContainer] .abHeading{
	padding: 22px 24px 6px;
	font-family: var(--modern-font-head);
	font-size: calc(var(--modern-fs) * 1.4);
	line-height: 1.3;
	font-weight: 600;
	color: var(--modern-heading);
}
/* stay + price recap strip */
[calendarContainer] .abForm .abBox.abGray{
	margin: 10px 20px 4px;
	padding: 8px 6px;
	background: color-mix(in srgb, var(--modern-soft) 55%, var(--modern-card));
	border-radius: var(--modern-rc);
}
[calendarContainer] .abParagraph{ margin: 0; overflow: visible; width: auto; }
[calendarContainer] .abParagraphInner{
	display: grid;
	grid-template-columns: minmax(120px, 38%) 1fr;
	column-gap: 14px;
	align-items: start;
	padding: 7px 14px;
}
[calendarContainer] .abForm .abTitle{
	float: none;
	width: auto;
	padding: 0;
	color: var(--modern-heading);
	font-size: calc(var(--modern-fs) * .93);
	font-weight: 600;
	line-height: 1.45;
	text-align: left;
}
[calendarContainer] .abForm .abTitle .abSubTitle{ display: inline-block; margin-top: 1px; font-size: calc(var(--modern-fs) * .8); color: var(--modern-muted); font-weight: 500; }
[calendarContainer] .abForm .abValue{
	float: none;
	padding: 0;
	color: var(--modern-heading);
	font-size: var(--modern-fs);
	line-height: 1.45;
	font-weight: 500;
}
[calendarContainer] .abForm .abPrice{ font-family: var(--modern-font-head); font-size: calc(var(--modern-fs) * 1.45); font-weight: 700; color: var(--modern-link); }
[calendarContainer] .abForm .abControl{ float: none; display: block; width: 100%; min-width: 0; box-sizing: border-box; }
[calendarContainer] .abForm .abStretch{ width: 100%; }
[calendarContainer] .abForm .abControl .abButton{ margin-bottom: 0; }
/* form fields card */
[calendarContainer] .abForm .abBox.abWhite:not(.abHeading){
	display: grid;
	grid-template-columns: 1fr 1fr;
	column-gap: 14px;
	padding: 14px 20px 22px;
}
[calendarContainer] .abForm .abBox.abWhite:not(.abHeading) .abParagraph{ min-width: 0; }
[calendarContainer] .abForm .abBox.abWhite:not(.abHeading) .abParagraphInner{
	display: flex;
	flex-direction: column;
	gap: 6px;
	padding: 8px 0;
}
[calendarContainer] .abForm .abBox.abWhite:not(.abHeading) .abTitle:empty,
[calendarContainer] .abForm .abBox.abWhite:not(.abHeading) .abTitle.abNbsp{ display: none; }
/* paragraphs that need the full row */
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(textarea),
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.abExtraWrapper),
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.abTerms),
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.abButton),
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(#pjAbcCaptchaImage),
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.g-recaptcha),
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.abValue),
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(select[name="payment_method"]),
[calendarContainer] .abForm .abBox.abWhite .abParagraph[id],
[calendarContainer] .abForm .abBox.abWhite .abParagraph:empty,
[calendarContainer] .abForm .abBox.abWhite .abSelectorTermsBody{ grid-column: 1 / -1; }
[calendarContainer] .abForm .abBox.abWhite .abParagraph:empty{ display: none; }
/* paragraphs whose left label is only a spacer (terms, buttons, messages) */
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.abTerms) .abTitle,
[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.abButton) .abTitle,
[calendarContainer] .abForm .abBox.abWhite #pjAbcCaptchaMessage .abTitle,
[calendarContainer] .abForm .abBox.abWhite #pjRpcMaxPeople .abTitle,
[calendarContainer] .abForm .abBox.abWhite #pjRpcMinPeople .abTitle{ display: none; }
/* inputs */
[calendarContainer] .abForm .abText,
[calendarContainer] .abForm .abSelect,
[calendarContainer] .abForm .abTextarea{
	float: none;
	display: block;
	width: 100%;
	max-width: 100%;
	height: 44px;
	margin: 0;
	padding: 9px 12px;
	background: color-mix(in srgb, var(--modern-page) 55%, var(--modern-card));
	border: 1px solid var(--modern-line);
	border-radius: var(--modern-ri);
	color: var(--modern-heading);
	font-family: inherit;
	font-size: var(--modern-fs);
	line-height: 1.4;
	outline: 0;
	box-shadow: none;
	-webkit-appearance: none;
	appearance: none;
}
[calendarContainer] .abForm .abSelect{
	line-height: 1.4;
	padding-right: 34px;
	background-image: linear-gradient(45deg, transparent 50%, var(--modern-muted) 50%), linear-gradient(135deg, var(--modern-muted) 50%, transparent 50%);
	background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%;
	background-size: 5px 5px, 5px 5px;
	background-repeat: no-repeat;
}
[calendarContainer] .abForm .abTextarea{ height: auto; min-height: 84px; resize: vertical; }
[calendarContainer] .abForm .abBox.abWhite .abSelect{ width: 100%; }
[calendarContainer] .abForm .abW50{ width: 50px; } 
[calendarContainer] .abForm .abW80{ width: 96px; }
[calendarContainer] .abForm .abW100{ width: 120px; }
[calendarContainer] .abForm .abText:focus,
[calendarContainer] .abForm .abSelect:focus,
[calendarContainer] .abForm .abTextarea:focus{
	border-color: var(--modern-accent);
	background-color: var(--modern-card);
	box-shadow: 0 0 0 3px color-mix(in srgb, var(--modern-accent) 28%, transparent);
}
/* validation */
[calendarContainer] .abForm label.abError,
[calendarContainer] .abForm span.abError,
[calendarContainer] .abForm .abBookingMsg{
	display: block;
	float: none;
	margin: 4px 0 0;
	padding: 0;
	color: var(--modern-error);
	font-size: calc(var(--modern-fs) * .86);
	line-height: 1.35;
	text-align: left;
	clear: none;
}
[calendarContainer] .abForm input.abError,
[calendarContainer] .abForm select.abError,
[calendarContainer] .abForm textarea.abError{
	background-color: color-mix(in srgb, var(--modern-error) 8%, var(--modern-card));
	border-color: var(--modern-error);
	color: var(--modern-heading);
}
[calendarContainer] .abForm input.abError:focus,
[calendarContainer] .abForm select.abError:focus,
[calendarContainer] .abForm textarea.abError:focus{
	background-color: color-mix(in srgb, var(--modern-error) 8%, var(--modern-card));
	border-color: var(--modern-error);
	box-shadow: 0 0 0 3px color-mix(in srgb, var(--modern-error) 22%, transparent);
}
[calendarContainer] .abForm input.abValid,
[calendarContainer] .abForm select.abValid,
[calendarContainer] .abForm textarea.abValid{
	background-color: var(--modern-card);
	border-color: var(--modern-free-text);
	color: var(--modern-heading);
}
[calendarContainer] .abExtraWrapper .abExtraHint,
[calendarContainer] .abWrapper .abExtraHint{ color: var(--modern-error); }
/* extras */
[calendarContainer] .abForm .abExtraWrapper{ margin: 0; }
[calendarContainer] .abForm .abExtraWrapper .abExtraHeading{
	display: flex;
	justify-content: space-between;
	margin: 0 0 6px;
	padding: 0 2px 6px;
	border-bottom: 1px solid var(--modern-line);
	font-size: calc(var(--modern-fs) * .85);
	font-weight: 600;
	letter-spacing: .04em;
	text-transform: uppercase;
	color: var(--modern-muted);
}
[calendarContainer] .abForm .abExtraWrapper .abExtraRow{
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	margin: 0 0 8px;
	padding: 9px 12px;
	border: 1px solid var(--modern-line);
	border-radius: var(--modern-ri);
	overflow: visible;
}
[calendarContainer] .abForm .abExtraWrapper .abExtraName{ float: none; width: auto; flex: 1 1 auto; }
[calendarContainer] .abForm .abExtraWrapper .abExtraQty{ float: none; width: auto; flex: 0 0 auto; }
[calendarContainer] .abForm .abExtraWrapper .abExtraHeading .abExtraName,
[calendarContainer] .abForm .abExtraWrapper .abExtraHeading .abExtraQty{ width: auto; }
[calendarContainer] .abForm .abExtraWrapper .abExtraName label{ display: inline; color: var(--modern-heading); font-weight: 500; }
[calendarContainer] .abForm .abExtraWrapper .abExtraName input[type='checkbox']{ display: inline-block; float: none; margin: 0 8px 0 0; vertical-align: middle; accent-color: var(--modern-btn); }
[calendarContainer] .abForm .abExtraWrapper .abExtraQty .abSelect{ width: 84px; height: 38px; }
/* captcha + terms */
[calendarContainer] .abForm .abCaptcha{ float: none; vertical-align: middle; margin: 0 10px 0 0; border-radius: var(--modern-ri); cursor: pointer; }
[calendarContainer] .abForm #pjAbcCaptchaInput{ display: inline-block; vertical-align: middle; width: 130px; }
[calendarContainer] .abForm .abTerms{ float: none; display: inline; color: var(--modern-body); font-weight: 500; font-size: var(--modern-fs); }
[calendarContainer] .abForm input[type=checkbox]{ accent-color: var(--modern-btn); width: 16px; height: 16px; vertical-align: -3px; margin: 0 8px 0 0; }
/* buttons */
[calendarContainer] .abButton{
	display: inline-block;
	border-radius: var(--modern-rb);
	padding: 11px 26px;
	font-family: var(--modern-font-body);
	font-size: var(--modern-fs);
	font-weight: 600;
	line-height: 1.3;
	cursor: pointer;
	transition: background-color .15s, border-color .15s, transform .05s;
}
[calendarContainer] .abButton:active{ transform: translateY(1px); }
[calendarContainer] .abButtonDefault{
	background: var(--modern-btn);
	background-image: none;
	filter: none;
	border: 1px solid var(--modern-btn);
	color: var(--modern-btn-text);
	box-shadow: none;
}
[calendarContainer] .abButtonDefault:hover,
[calendarContainer] .abButtonDefault:focus{ background: var(--modern-btn-hover); border-color: var(--modern-btn-hover); color: var(--modern-btn-text); }
[calendarContainer] .abButtonCancel{
	background: var(--modern-btn2);
	background-image: none;
	filter: none;
	border: 1px solid var(--modern-line);
	color: var(--modern-btn2-text);
	box-shadow: none;
}
[calendarContainer] .abButtonCancel:hover,
[calendarContainer] .abButtonCancel:focus{ border-color: var(--modern-accent); color: var(--modern-btn2-text); }
[calendarContainer] .abButton:focus-visible{ outline: 2px solid var(--modern-accent); outline-offset: 2px; }
[calendarContainer] .abForm .abFloatleft{ float: none; }
[calendarContainer] .abForm .abMR5{ margin-right: 8px; }
/* payment / confirmation */
[calendarContainer] .abPaymentForm .abBox{ padding: 30px 24px; text-align: center; font-size: calc(var(--modern-fs) * 1.07); color: var(--modern-heading); background: transparent; }
[calendarContainer] .abPaymentForm .abBox:before{
	content: "\2713";
	display: block;
	width: 62px;
	height: 62px;
	margin: 0 auto 14px;
	border-radius: 50%;
	background: var(--modern-free);
	color: var(--modern-free-text);
	font-size: 30px;
	line-height: 62px;
	font-weight: 700;
}
[calendarContainer] .abPaymentForm .abBox span.abError{ color: var(--modern-error); }
[calendarContainer] .abPaymentForm .abBox:has(.abError):before{ content: "!"; background: color-mix(in srgb, var(--modern-error) 14%, var(--modern-card)); color: var(--modern-error); }
[calendarContainer] .abPaymentForm .abBox .abStartOver{ float: none; display: inline-block; margin-top: 16px; font-size: var(--modern-fs); text-transform: none; }
[calendarContainer] .abForm.abPaymentForm .abBox.abGray,
[calendarContainer] .abPaymentForm .abBox.abGray{ margin: 0; padding: 30px 24px; background: transparent; border-radius: 0; }
/* tooltips + messages */
.abCalendarTooltip{ color: #fff; font-family: inherit; }
.abCalendarTooltip .abCalendarTooltipInner{ background: var(--modern-heading, #1b3550); color: #fff; border: 0; border-radius: var(--modern-ri, 10px); padding: 6px 10px; font-family: var(--modern-font-body, 'Poppins', system-ui, sans-serif); font-size: calc(var(--modern-fs, 14px) * .93); font-weight: 600; box-shadow: 0 8px 24px rgba(0,0,0,.25); }
.abCalendarTooltip .abCalendarTooltipInner:after{ border-top-color: var(--modern-heading, #1b3550); }
.abCalendarTooltip .abCalendarTooltipInner:before{ display: none; }
.abCalendarMessage .abCalendarMessageInner{ background: #fff; border: 1px solid var(--modern-error, #be3d21); color: var(--modern-heading, #1b3550); border-radius: var(--modern-ri, 10px); padding: 6px 10px; font-family: var(--modern-font-body, 'Poppins', system-ui, sans-serif); font-size: calc(var(--modern-fs, 14px) * .93); }
/* terms dialog */
.abDialog{ border-radius: 14px; box-shadow: 0 20px 60px rgba(0,0,0,.3); }

/* ---- compact calendar (narrow containers, e.g. the calendar inside the admin) ---- */
@container abmodern (max-width: 520px){
	[calendarContainer] table.abCalendarLegend{ padding: 8px 6px; border-spacing: 2px 0; font-size: calc(var(--modern-fs) * .78); }
	[calendarContainer] td.abCalendarColor{ width: 12px; min-width: 12px; }
	[calendarContainer] td.abCalendarLabel{ padding: 0 6px 0 3px; }
	[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:link,
	[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:visited,
	[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:active,
	[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:hover,
	[calendarContainer] td.abCalendarMonth a.abCalendarLinkMonth:focus{ width: 30px; height: 30px; }
	[calendarContainer] td.abCalendarWeekDay{ font-size: calc(var(--modern-fs) * .68); letter-spacing: .01em; }
	[calendarContainer] td.abCalendarWeekDay span.abCalendarWeekDayInner{ padding: 2px 0; white-space: nowrap; overflow: hidden; text-overflow: clip; }
	[calendarContainer] .abCalendarLinkDate{ padding: 11px 0; }
	[calendarContainer] td.abCalendarDate,
	[calendarContainer] td.abCalendarToday,
	[calendarContainer] td.abCalendarReserved,
	[calendarContainer] td.abCalendarPending,
	[calendarContainer] td.abCalendarPast,
	[calendarContainer] td.abCalendarEmpty{ border-radius: var(--modern-cell); font-size: calc(var(--modern-fs) * .93); }
}
@container abmodern (max-width: 360px){
	[calendarContainer] .abCalendarLinkDate{ padding: 9px 0; }
	[calendarContainer] td.abCalendarWeekDay{ font-size: calc(var(--modern-fs) * .6); letter-spacing: 0; }
}

/* ---- responsive: follows the width of the page the script is embedded in (container query), media query as fallback ---- */
@container abmodern (max-width: 560px){
	[calendarContainer] .abForm .abBox.abWhite:not(.abHeading){ grid-template-columns: 1fr; padding: 10px 14px 18px; }
	[calendarContainer] .abParagraphInner{ grid-template-columns: 1fr; row-gap: 2px; padding: 6px 12px; }
	[calendarContainer] .abHeading{ padding: 18px 16px 4px; }
	[calendarContainer] .abForm .abBox.abGray{ margin: 8px 12px 2px; }
	[calendarContainer] .abButton{ padding: 11px 18px; }
	[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.abButton) .abControl{ display: flex; gap: 8px; }
	[calendarContainer] .abForm .abBox.abWhite .abParagraph:has(.abButton) .abButton{ flex: 1; margin: 0; }
}
@media screen and (max-width: 560px){
	[calendarContainer] .abForm .abBox.abWhite:not(.abHeading){ grid-template-columns: 1fr; }
	[calendarContainer] .abParagraphInner{ grid-template-columns: 1fr; row-gap: 2px; }
}

/* ======================================================================
   Booking steps: progress bar, stay chip, receipt-style price list
   ====================================================================== */
[calendarContainer] .abProg{ margin: 2px 6px 16px; font-family: var(--modern-font-body); }
[calendarContainer] .abProgT{ display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 9px; }
[calendarContainer] .abProgT b{ font-size: calc(var(--modern-fs) * .9); color: var(--modern-heading); }
[calendarContainer] .abProgT span{ font-size: calc(var(--modern-fs) * .85); color: var(--modern-muted); }
[calendarContainer] .abProgSeg,
[calendarContainer] .abProgLab{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
[calendarContainer] .abProgSeg i{ height: 5px; border-radius: 5px; background: var(--modern-line); transition: background .3s; }
[calendarContainer] .abProgSeg i.on{ background: var(--modern-btn); }
[calendarContainer] .abProgLab{ margin-top: 7px; }
[calendarContainer] .abProgLab span{ font-size: calc(var(--modern-fs) * .78); font-weight: 600; color: var(--modern-muted); }
[calendarContainer] .abProgLab span.on{ color: var(--modern-heading); }
@container abmodern (max-width: 520px){
	[calendarContainer] .abProgLab span:not(.cur){ visibility: hidden; }
}

[calendarContainer] .abHeading{ font-family: var(--modern-font-head); letter-spacing: -.01em; }

/* stay chip replaces the arrival / departure / nights rows */
[calendarContainer] .abForm .abBox.abGray{ display: block; padding: 0; background: transparent; margin: 10px 20px 6px; }
[calendarContainer] .abForm .abBox.abGray:has(> .abStay) > .abParagraph:nth-child(-n+4){ display: none; }
[calendarContainer] .abStay{
	display: flex;
	align-items: center;
	gap: 14px;
	padding: 13px 15px;
	margin: 0 0 18px;
	background: var(--modern-card);
	border: 1.5px solid var(--modern-line);
	border-radius: var(--modern-rc);
	font-family: var(--modern-font-body);
}
[calendarContainer] .abStayCal{ flex: 0 0 auto; width: 44px; border-radius: var(--modern-ri); overflow: hidden; text-align: center; line-height: 1; background: var(--modern-btn); color: var(--modern-btn-text); }
[calendarContainer] .abStayCal small{ display: block; padding: 4px 0; font-size: calc(var(--modern-fs) * .68); letter-spacing: .1em; text-transform: uppercase; background: rgba(0,0,0,.22); }
[calendarContainer] .abStayCal b{ display: block; padding: 6px 0 7px; font-size: calc(var(--modern-fs) * 1.35); }
[calendarContainer] .abStayTx{ flex: 1; min-width: 0; }
[calendarContainer] .abStayTx b{ display: block; font-size: var(--modern-fs); color: var(--modern-heading); }
[calendarContainer] .abStayTx span{ font-size: calc(var(--modern-fs) * .82); color: var(--modern-muted); }
[calendarContainer] .abStay a.abSelectorChangeDates{
	flex: 0 0 auto;
	padding: 6px 11px;
	border-radius: 8px;
	background: var(--modern-soft);
	color: var(--modern-heading);
	font-size: calc(var(--modern-fs) * .85);
	font-weight: 600;
	text-decoration: none;
}

/* price list as a receipt */
[calendarContainer] .abForm .abSelectorPrice{ background: var(--modern-card); border: 1px solid var(--modern-line); border-radius: var(--modern-rc); padding: 6px 8px; }
[calendarContainer] .abForm .abSelectorPrice .abParagraphInner{ grid-template-columns: 1fr auto; align-items: baseline; padding: 9px 10px; }
[calendarContainer] .abForm .abSelectorPrice .abParagraph + .abParagraph{ border-top: 1px dashed var(--modern-line); }
[calendarContainer] .abForm .abSelectorPrice .abTitle{ font-weight: 400; color: var(--modern-muted); }
[calendarContainer] .abForm .abSelectorPrice .abValue{ text-align: right; font-weight: 600; }
[calendarContainer] .abForm .abSelectorPrice .abValue.abPrice{ font-family: var(--modern-font-head); font-size: calc(var(--modern-fs) * 1.25); }

/* payment method as selectable cards (select stays in the DOM for validation) */
[calendarContainer] .abPayCards{
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
	gap: 10px;
	margin-bottom: 4px;
}
[calendarContainer] .abPayCard{
	display: flex;
	align-items: center;
	gap: 10px;
	margin: 0;
	padding: 12px 14px;
	box-sizing: border-box;
	background: var(--modern-card);
	border: 1.5px solid var(--modern-line);
	border-radius: var(--modern-rc);
	color: var(--modern-heading);
	font-family: var(--modern-font-body);
	font-size: var(--modern-fs);
	font-weight: 600;
	text-align: left;
	cursor: pointer;
	transition: border-color .15s, background-color .15s;
}
[calendarContainer] .abPayCard:hover{ border-color: var(--modern-accent); }
[calendarContainer] .abPayCard:before{
	content: "";
	flex: 0 0 auto;
	width: 18px;
	height: 18px;
	box-sizing: border-box;
	border-radius: 50%;
	border: 2px solid var(--modern-line);
	background: var(--modern-card);
}
[calendarContainer] .abPayCard.abPayOn{ border-color: var(--modern-btn); background: color-mix(in srgb, var(--modern-soft) 40%, var(--modern-card)); }
[calendarContainer] .abPayCard.abPayOn:before{ border-color: var(--modern-btn); background: radial-gradient(var(--modern-btn) 45%, var(--modern-card) 50%); }
[calendarContainer] .abPayCard:focus-visible{ outline: 3px solid color-mix(in srgb, var(--modern-accent) 40%, transparent); outline-offset: 2px; }
[calendarContainer] .abPayCards + select.abSelect{
	position: absolute;
	width: 1px;
	height: 1px;
	opacity: 0;
	pointer-events: none;
	overflow: hidden;
}

/* review (summary) page: values as a tidy details list */
[calendarContainer] .abForm .abSelectorPrice + .abParagraph{ margin-top: 0; }

/* price list: the trailing empty row is not part of the list; the last real row is the highlighted total */
[calendarContainer] .abForm .abSelectorPrice .abParagraph:empty{ display: none; }
[calendarContainer] .abForm .abSelectorPrice .abParagraph:has(+ .abParagraph:empty){
	margin: 6px 0 2px;
	border-top: 0;
	border-radius: var(--modern-rc);
	background: var(--modern-free);
}


/* review page: details as a two-column list */
[calendarContainer] .abSummaryForm .abBox.abWhite:not(.abHeading){ column-gap: 22px; padding: 16px 24px 22px; }
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraph:has(.abValue){
	grid-column: auto;
	border-bottom: 1px dashed var(--modern-line);
}
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraph:has(.abValue):has(.abTitle:empty),
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraph:has(textarea),
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraph:has(.abBookingMsg),
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraph:has(.abButton){ grid-column: 1 / -1; }
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraph:has(.abValue:empty){ display: none; }
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraphInner{ padding: 9px 0; }
[calendarContainer] .abSummaryForm .abBox.abWhite .abTitle{
	font-size: calc(var(--modern-fs) * .72);
	letter-spacing: .06em;
	text-transform: uppercase;
	color: var(--modern-muted);
}
[calendarContainer] .abSummaryForm .abBox.abWhite .abValue{ font-weight: 600; word-break: break-word; }
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraph:has(.abButton){ border-bottom: 0; }
[calendarContainer] .abSummaryForm .abBox.abWhite .abParagraph:has(.abButton) .abParagraphInner{ padding-top: 14px; }

/* confirmation page: centred success state (not a grid) */
[calendarContainer] .abPaymentForm .abBox.abGray{ display: block; }
[calendarContainer] .abPaymentForm .abBox.abGray > *{ grid-column: auto; }

/* floating labels (set up by modernFloat in the script) */
[calendarContainer] .abSelectorBookingForm .abParagraph.abFloat .abParagraphInner{ position: relative; grid-template-columns: 1fr; }
[calendarContainer] .abSelectorBookingForm .abParagraph.abFloat .abTitle{
	position: absolute;
	z-index: 1;
	left: 15px;
	top: 17px;
	margin: 0;
	font-size: var(--modern-fs);
	font-weight: 400;
	color: var(--modern-muted);
	pointer-events: none;
	transition: top .15s, font-size .15s;
}
[calendarContainer] .abSelectorBookingForm .abParagraph.abFloat.abFilled .abTitle,
[calendarContainer] .abSelectorBookingForm .abParagraph.abFloat:focus-within .abTitle{ top: 7px; font-size: calc(var(--modern-fs) * .8); font-weight: 600; letter-spacing: .03em; }
[calendarContainer] .abSelectorBookingForm .abParagraph.abFloat .abControl input,
[calendarContainer] .abSelectorBookingForm .abParagraph.abFloat .abControl select{ height: 54px; padding-top: 22px; padding-bottom: 6px; }

/* bottom bar: total due + buttons */
[calendarContainer] .abForm .abBox .abParagraph.abDock{
	position: sticky;
	bottom: 0;
	z-index: 3;
	grid-column: 1 / -1;
	margin: 18px -24px -22px;
	padding: 0;
	background: color-mix(in srgb, var(--modern-card) 94%, transparent);
	-webkit-backdrop-filter: blur(8px);
	backdrop-filter: blur(8px);
	border-top: 1px solid var(--modern-line);
	border-bottom: 0;
	border-radius: 0 0 var(--modern-rb) var(--modern-rb);
}
[calendarContainer] .abForm .abBox .abParagraph.abDock .abParagraphInner{ display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 14px; padding: 14px 24px 16px; }
[calendarContainer] .abForm .abBox .abParagraph.abDock .abTitle{ display: none; }
[calendarContainer] .abDockSum{ flex: 1 1 auto; min-width: 0; text-align: left; }
[calendarContainer] .abDockSum small{ display: block; font-size: calc(var(--modern-fs) * .78); color: var(--modern-muted); font-weight: 400; letter-spacing: 0; text-transform: none; }
[calendarContainer] .abDockSum b{ display: block; font-family: var(--modern-font-head); font-size: calc(var(--modern-fs) * 1.5); color: var(--modern-heading); font-weight: 700; }
[calendarContainer] .abForm .abBox .abParagraph.abDock .abControl{ flex: 0 0 auto; display: flex; flex-direction: row-reverse; gap: 10px; width: auto; }
[calendarContainer] .abDock .abControl .abButton{ float: none; margin: 0; }
@container abmodern (max-width: 420px){
	[calendarContainer] .abForm .abBox .abParagraph.abDock .abParagraphInner{ padding: 12px 14px 14px; gap: 10px; }
	[calendarContainer] .abForm .abBox .abParagraph.abDock{ margin-left: -14px; margin-right: -14px; }
	[calendarContainer] .abDock .abControl .abButton{ padding-left: 16px; padding-right: 16px; }
}

/* booking reference on the confirmation page */
[calendarContainer] .abRef{
	display: inline-block;
	margin: 0 0 14px;
	padding: 7px 15px;
	border: 1.5px dashed var(--modern-btn);
	border-radius: 999px;
	color: var(--modern-heading);
	font-weight: 700;
	letter-spacing: .06em;
	font-size: calc(var(--modern-fs) * .85);
}

/* "All calendars" view: once one calendar is opened, show it at the normal widget width, centred */
[calendarContainer]:has(.abProg, .abModernCal){ max-width: 680px; margin-left: auto; margin-right: auto; }

/* ==========================================================================
   Calendar step (Modern): compact single-month card, no progress bar.
   Active only when the markup carries .abModernCal (single-month view).
   ========================================================================== */
[calendarContainer]:has(.abModernCal){ padding: 14px 14px 0; position: relative; }
[calendarContainer]:has(.abModernCal) .abCalendarNote{
	display: flex; align-items: flex-start; gap: 8px;
	margin: 0 0 10px; padding: 9px 12px;
	background: var(--modern-soft); color: var(--modern-heading);
	border-radius: var(--modern-ri);
	font-size: calc(var(--modern-fs) * .9); line-height: 1.4;
}
[calendarContainer]:has(.abModernCal) .abCalendarNote:before{
	content: "i"; flex: none; width: 17px; height: 17px; margin-top: 1px; border-radius: 50%;
	border: 1.5px solid currentColor; font: 700 11px/14px Georgia, serif; text-align: center; opacity: .8;
}
[calendarContainer]:has(.abModernCal) table.abCalendarTable{
	border-spacing: 0; padding: 12px 12px 10px; box-shadow: var(--modern-shadow);
	border: 1px solid var(--modern-line);
}
/* grid: 1 narrow week column + 7 day columns; the first row becomes the toolbar (month title left, arrows and language right) */
[calendarContainer]:has(.abModernCal) table.abCalendarTable{ display: block; }
[calendarContainer]:has(.abModernCal) table.abCalendarTable > tbody{
	display: grid; grid-template-columns: 22px repeat(7, minmax(0, 1fr)); gap: 4px; width: 100%;
}
[calendarContainer]:has(.abModernCal) table.abCalendarTable > tbody > tr{ display: contents; }
[calendarContainer]:has(.abModernCal) td.abCalendarMonth{
	height: auto !important; line-height: 1.2 !important; padding: 0; margin-bottom: 6px;
	font-size: calc(var(--modern-fs) * 1.25); text-align: left; align-self: center;
	grid-column: 1 / -3; white-space: normal; overflow: visible; overflow-wrap: anywhere;
}
[calendarContainer]:has(.abModernCal) td.abCalendarMonthPrev,
[calendarContainer]:has(.abModernCal) td.abCalendarMonthNext{ width: auto; margin-bottom: 6px; overflow: visible; }
[calendarContainer]:has(.abModernCal) td.abCalendarMonthPrev{ grid-column: -3 / -2; justify-self: end; grid-row: 1; }
[calendarContainer]:has(.abModernCal) td.abCalendarMonthNext{ grid-column: -2 / -1; justify-self: start; grid-row: 1; }
[calendarContainer]:has(.abModernCal) td.abCalendarMonth:not(.abCalendarMonthPrev):not(.abCalendarMonthNext){ grid-row: 1; }
[calendarContainer]:has(.abModernCal) table.abCalendarTable > tbody:has(td.abCalendarLang) td.abCalendarMonth:not(.abCalendarMonthPrev):not(.abCalendarMonthNext){ grid-column: 1 / -5; }
[calendarContainer]:has(.abModernCal) table.abCalendarTable > tbody:has(td.abCalendarLang) td.abCalendarMonthPrev{ grid-column: -5 / -4; }
[calendarContainer]:has(.abModernCal) table.abCalendarTable > tbody:has(td.abCalendarLang) td.abCalendarMonthNext{ grid-column: -4 / -3; }
[calendarContainer]:has(.abModernCal) td.abCalendarMonth a.abCalendarLinkMonth:link,
[calendarContainer]:has(.abModernCal) td.abCalendarMonth a.abCalendarLinkMonth:visited,
[calendarContainer]:has(.abModernCal) td.abCalendarMonth a.abCalendarLinkMonth:active,
[calendarContainer]:has(.abModernCal) td.abCalendarMonth a.abCalendarLinkMonth:hover,
[calendarContainer]:has(.abModernCal) td.abCalendarMonth a.abCalendarLinkMonth:focus{
	width: 34px; height: 34px; border-radius: var(--modern-ri); box-shadow: none;
}
[calendarContainer]:has(.abModernCal) td.abCalendarMonth a.abCalendarLinkMonth:hover{ background: var(--modern-soft); }
[calendarContainer]:has(.abModernCal) td.abCalendarLang{
	grid-column: -3 / -1; grid-row: 1; justify-self: end; align-self: center; margin-bottom: 6px;
	padding: 0; border: 0; background: none; height: auto !important; line-height: 1 !important; overflow: visible;
}
[calendarContainer]:has(.abModernCal) td.abCalendarLang .pjRpbcLanguage{ float: none; display: block; }
[calendarContainer]:has(.abModernCal) td.abCalendarLang .pjRpbcBtnNav{
	height: 34px; border-radius: var(--modern-ri); padding: 0 9px; font-size: calc(var(--modern-fs) * .85); font-weight: 600;
	display: inline-flex; align-items: center; gap: 6px; box-shadow: none;
	border: 1px solid var(--modern-line); background: var(--modern-btn2); color: var(--modern-heading);
}
[calendarContainer]:has(.abModernCal) td.abCalendarLang .pjRpbcBtnNav img{ width: 18px; height: 13px; border-radius: 2px; object-fit: cover; }
[calendarContainer]:has(.abModernCal) td.abCalendarLang .dropdown-menu{ right: 0; left: auto; min-width: 150px; z-index: 20; }
/* week days + week numbers */
[calendarContainer]:has(.abModernCal) td.abCalendarWeekDay{ height: auto !important; line-height: 1.2 !important; padding: 2px 0 4px; font-size: calc(var(--modern-fs) * .72); }
[calendarContainer]:has(.abModernCal) td.abCalendarWeekDay:first-child,
[calendarContainer]:has(.abModernCal) td.abCalendarWeekNum{ width: 22px; }
[calendarContainer]:has(.abModernCal) td.abCalendarWeekDay:first-child .abCalendarWeekDayInner{ visibility: hidden; }
[calendarContainer]:has(.abModernCal) td.abCalendarWeekNum{ align-self: center; height: auto !important; line-height: 1 !important; font-size: calc(var(--modern-fs) * .7); font-weight: 500; opacity: .55; padding: 0; }
/* day cells: square, compact */
[calendarContainer]:has(.abModernCal) td.abCalendarDate,
[calendarContainer]:has(.abModernCal) td.abCalendarToday,
[calendarContainer]:has(.abModernCal) td.abCalendarReserved,
[calendarContainer]:has(.abModernCal) td.abCalendarPending,
[calendarContainer]:has(.abModernCal) td.abCalendarPast,
[calendarContainer]:has(.abModernCal) td.abCalendarEmpty,
[calendarContainer]:has(.abModernCal) td.abCalendarPendingNightsStart,
[calendarContainer]:has(.abModernCal) td.abCalendarPendingNightsEnd,
[calendarContainer]:has(.abModernCal) td.abCalendarReservedNightsStart,
[calendarContainer]:has(.abModernCal) td.abCalendarReservedNightsEnd,
[calendarContainer]:has(.abModernCal) td.abCalendarNightsReservedReserved,
[calendarContainer]:has(.abModernCal) td.abCalendarNightsReservedPending,
[calendarContainer]:has(.abModernCal) td.abCalendarNightsPendingReserved,
[calendarContainer]:has(.abModernCal) td.abCalendarNightsPendingPending{
	height: auto !important; line-height: 1 !important; padding: 0; border-radius: var(--modern-cell);
	font-size: calc(var(--modern-fs) * .96);
}
[calendarContainer]:has(.abModernCal) .abCalendarLinkDate{ padding: 0; width: 100%; aspect-ratio: 1 / 1; box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex-direction: column; }
[calendarContainer]:has(.abModernCal) td.abCalendarEmpty{ aspect-ratio: 1 / 1; }
/* fit in a glance: the cell height is capped so toolbar + 6 week rows + legend + bottom bar fit the viewport (squares when there is room) */
[calendarContainer]:has(.abModernCal){ --abCellH: clamp(32px, calc((100vh - 295px) / 6 - 4px), 84px); }
@supports (height: 100dvh){ [calendarContainer]:has(.abModernCal){ --abCellH: clamp(32px, calc((100dvh - 295px) / 6 - 4px), 84px); } }
/* every day cell is a true square (a circle in the round design): width = height, centred in its column */
[calendarContainer]:has(.abModernCal) td.abCalendarDate,
[calendarContainer]:has(.abModernCal) td.abCalendarToday,
[calendarContainer]:has(.abModernCal) td.abCalendarReserved,
[calendarContainer]:has(.abModernCal) td.abCalendarPending,
[calendarContainer]:has(.abModernCal) td.abCalendarPast,
[calendarContainer]:has(.abModernCal) td.abCalendarEmpty,
[calendarContainer]:has(.abModernCal) td.abCalendarPendingNightsStart,
[calendarContainer]:has(.abModernCal) td.abCalendarPendingNightsEnd,
[calendarContainer]:has(.abModernCal) td.abCalendarReservedNightsStart,
[calendarContainer]:has(.abModernCal) td.abCalendarReservedNightsEnd,
[calendarContainer]:has(.abModernCal) td.abCalendarNightsReservedReserved,
[calendarContainer]:has(.abModernCal) td.abCalendarNightsReservedPending,
[calendarContainer]:has(.abModernCal) td.abCalendarNightsPendingReserved,
[calendarContainer]:has(.abModernCal) td.abCalendarNightsPendingPending{ width: min(100%, var(--abCellH)); aspect-ratio: 1 / 1; justify-self: center; }
[calendarContainer]:has(.abModernCal) .abCalendarNote{ margin-bottom: 8px; }
[calendarContainer]:has(.abModernCal) table.abCalendarLegend{ margin-top: 6px; padding: 4px 12px; }
[calendarContainer]:has(.abModernCal) td.abCalendarDate:hover,
[calendarContainer]:has(.abModernCal) td.abCalendarPending:hover{ filter: none; box-shadow: 0 6px 12px -6px color-mix(in srgb, var(--modern-heading) 40%, transparent); }
[calendarContainer]:has(.abModernCal) td.abCalendarReserved{ text-decoration: line-through; text-decoration-thickness: 1px; font-weight: 500; }
/* chosen range */
/* the tint only goes on free days: booked and pending days keep their own look inside a highlighted range */
[calendarContainer]:has(.abModernCal) td.abCalendarMark:not(.abCalendarReserved):not(.abCalendarPending),
[calendarContainer]:has(.abModernCal) td.abCalendarSelect:not(.abCalendarReserved):not(.abCalendarPending){
	background-color: var(--modern-soft) !important; background-image: none !important; color: var(--modern-heading) !important; border-radius: var(--modern-cell);
}
[calendarContainer]:has(.abModernCal) td.abCalendarFirstSelect.abCalendarFirstSelect:not(.abCalendarReserved),
[calendarContainer]:has(.abModernCal) td.abCalendarEndSelect.abCalendarEndSelect:not(.abCalendarReserved){
	background-color: var(--modern-btn) !important; background-image: none !important; color: var(--modern-btn-text) !important;
	box-shadow: 0 8px 16px -8px var(--modern-btn);
}
[calendarContainer]:has(.abModernCal) td.abCalendarFirstSelect.abCalendarFirstSelect{ border-radius: var(--modern-cell) !important; }
[calendarContainer]:has(.abModernCal) td.abCalendarEndSelect.abCalendarEndSelect{ border-radius: var(--modern-cell) !important; }
[calendarContainer]:has(.abModernCal) td.abCalendarFirstSelect.abCalendarEndSelect{ border-radius: var(--modern-cell); }
/* legend: light chips below the card */
[calendarContainer]:has(.abModernCal) table.abCalendarLegend{
	margin: 10px 0 0; padding: 8px 12px; border-spacing: 0; box-shadow: none; background: transparent;
	display: block; font-size: calc(var(--modern-fs) * .82);
}
[calendarContainer]:has(.abModernCal) table.abCalendarLegend tbody,
[calendarContainer]:has(.abModernCal) table.abCalendarLegend tr{ display: flex; flex-wrap: wrap; gap: 4px 14px; justify-content: center; }
[calendarContainer]:has(.abModernCal) td.abCalendarColor{ width: 12px; min-width: 12px; height: 12px; border-radius: 4px; align-self: center; }
[calendarContainer]:has(.abModernCal) td.abCalendarLabel{ padding: 0 0 0 2px; }
/* bottom bar */
.abCalDock{
	position: sticky; bottom: 0; z-index: 5;
	display: flex; align-items: center; gap: 12px;
	margin: 10px -14px 0; padding: 12px 14px;
	background: var(--modern-card); border-top: 1px solid var(--modern-line);
	border-radius: 0 0 var(--modern-r) var(--modern-r);
	box-shadow: var(--modern-dock-shadow);
	font-family: var(--modern-font-body);
}
.abCalDockSum{ flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.25; }
.abCalDockSum small{ font-size: calc(var(--modern-fs) * .72); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--modern-muted); }
.abCalDockSum b{ font-size: var(--modern-fs); color: var(--modern-heading); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.abCalDockSum span{ font-size: calc(var(--modern-fs) * .85); color: var(--modern-muted); }
.abCalDock a.abCalDockClear:link, .abCalDock a.abCalDockClear:visited{ color: var(--modern-link); font-weight: 600; font-size: calc(var(--modern-fs) * .88); text-decoration: none; }
.abCalDock .abCalDockGo{
	border: 0; border-radius: var(--modern-rb); padding: 12px 22px; cursor: pointer; white-space: nowrap;
	background: var(--modern-btn); color: var(--modern-btn-text);
	font: 600 var(--modern-fs) var(--modern-font-body); transition: background .15s;
}
.abCalDock .abCalDockGo:hover:not(:disabled){ background: var(--modern-btn-hover); }
.abCalDock .abCalDockGo:disabled{ background: color-mix(in srgb, var(--modern-btn) 28%, #fff); cursor: not-allowed; }
@container abmodern (max-width: 420px){
	.abCalDock .abCalDockGo{ padding: 11px 14px; }
}


/* Required fields: red asterisk after the label */
[calendarContainer] .abSelectorBookingForm .abParagraph.abReq > .abParagraphInner > .abTitle::after{
	content: " *"; color: var(--modern-error); font-weight: 700;
}
[calendarContainer] .abSelectorBookingForm .abParagraph.abReq .abControl > label.abTerms::after{
	content: " *"; color: var(--modern-error); font-weight: 700;
}

/* Details page: numbered section titles / Review page: titled blocks */
[calendarContainer] .abSelectorBookingForm .abBox.abWhite:not(.abHeading){ counter-reset: abSec; }
[calendarContainer] .abSecTitle{
	grid-column: 1 / -1; display: flex; align-items: center; gap: 10px;
	margin: 16px 0 4px; font-size: calc(var(--modern-fs) * .95); font-weight: 700; color: var(--modern-heading);
}
[calendarContainer] .abSecTitle:first-child{ margin-top: 2px; }
[calendarContainer] .abSelectorBookingForm .abSecTitle::before,
[calendarContainer] .abSelectorBookingForm .abPaymentMethodWrap .abTitle::before{
	counter-increment: abSec; content: counter(abSec);
	display: inline-grid; place-items: center; width: 24px; height: 24px; margin-right: 10px;
	border-radius: 50%; background: var(--modern-link); color: #fff; font-size: 12px; font-weight: 700;
}
[calendarContainer] .abSelectorBookingForm .abSecTitle::before{ margin-right: 0; }
[calendarContainer] .abSelectorBookingForm .abPaymentMethodWrap .abTitle{ display: flex; align-items: center; font-weight: 700; }
[calendarContainer] .abSelectorBookingForm .abPaymentMethodWrap .abTitle::after{ margin-left: 4px; }
[calendarContainer] .abSummaryForm .abSecTitle.abRv{ margin: 14px 0 2px; justify-content: space-between; }
[calendarContainer] .abSummaryForm .abBox.abGray .abSecTitle.abRv{ padding: 0 2px; }
[calendarContainer] .abSecEdit{
	font-size: calc(var(--modern-fs) * .85); font-weight: 600; text-decoration: none;
	color: var(--modern-link); background: color-mix(in srgb, var(--modern-link) 12%, transparent);
	padding: 5px 12px; border-radius: 9px;
}

/* ---- several months at once (3 / 6 / 12): week day names must fit their narrow columns in every language ---- */
[calendarContainer].abWrapper13 td.abCalendarWeekDay{
	font-size: calc(var(--modern-fs) * .56);
	letter-spacing: 0;
	padding-left: 0;
	padding-right: 0;
	text-align: center;
	overflow: hidden;
}
[calendarContainer].abWrapper13 td.abCalendarWeekDay span.abCalendarWeekDayInner{
	display: block;
	padding: 4px 0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: clip;
}
/* the first header cell is the (unlabelled) week number column */
[calendarContainer].abWrapper13 td.abCalendarWeekDay:first-child span.abCalendarWeekDayInner{ visibility: hidden; }

/* Vouchers */
[calendarContainer] .abVoucherBox .abControl{ display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
[calendarContainer] .abVoucherBox .abVoucherInput{ flex:1 1 140px; min-width:0; max-width:220px; }
[calendarContainer] .abVoucherBox .abVoucherApply{ flex:0 0 auto; }
[calendarContainer] .abVoucherBox .abVoucherMsg{ flex:1 1 100%; font-size:calc(var(--modern-fs)*.85); }
[calendarContainer] .abVoucherBox .abVoucherMsg.abVoucherError{ color:var(--modern-error); }
[calendarContainer] .abVoucherBox .abVoucherApplied{ color:var(--modern-ok); }
[calendarContainer] .abVoucherBox .abVoucherRemove{ margin-left:4px; }
[calendarContainer] .abVoucherRow .abVoucherDiscount{ color:var(--modern-ok); }
